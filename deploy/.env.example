# Copy to deploy/.env and fill with strong random values, e.g.  openssl rand -hex 32
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
ZT_GATEWAY_SECRET=
# Approved factory networks ONLY (office/plant device VLANs). Exclude guest Wi-Fi,
# labour-colony and machine-control networks.  Example: 10.10.20.0/24,10.10.30.0/24
ZT_ALLOWED_CIDRS=
# Folder holding server.crt / server.key for the internal hostname (e.g. erp.kantam.local)
TLS_DIR=./tls
# Bind the gateway to the plant-LAN interface address only, e.g. 10.10.20.5
GATEWAY_BIND=0.0.0.0
